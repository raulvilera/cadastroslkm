# ── Cliente (Vite: vai para o navegador; use SOMENTE chaves públicas) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Servidor (Vercel → Environment Variables; NUNCA use prefixo VITE_) ──
# Chave do Gemini, usada por /api/gemini
GEMINI_API_KEY=
# Projeto Supabase (usado para validar o login e a lista de autorizados)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# URL da implantação do Apps Script (Web App) e o segredo do proxy
APPS_SCRIPT_URL=
SHEETS_PROXY_SECRET=
